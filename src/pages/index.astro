---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Cambia tu WhatsApp aquí:
const whatsapp = "59163152931";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LLAMACODE | Tu negocio en internet con estilo y resultados</title>
    <meta
      name="description"
      content="Diseñamos páginas web atractivas y rápidas para atraer clientes, mostrar tu marca y vender más. Planes para todo tipo de negocio."
    />
    <meta property="og:title" content="LLAMACODE" />
    <meta
      property="og:description"
      content="Tu negocio, en internet con estilo y resultados."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/favicon.svg" />
    <!-- Tipografía -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-gray-50 text-gray-800">
    <Header />

    <main>
      <!-- HERO (sin tecnicismos, foco en resultados) -->
      <section class="hero">
        <div class="container section grid md:grid-cols-2 gap-10 items-center">
          <!-- Imagen primero en móvil -->
          <div
            class="order-1 md:order-2 reveal md:justify-self-end flex justify-center"
          >
            <img
              src="/systems.png"
              alt="Diseño web moderno de LLAMACODE"
              class="w-4/5 max-w-[320px] md:max-w-[560px] drop-shadow-2xl object-contain"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>

          <!-- Texto primero en desktop -->
          <div class="order-2 md:order-1 reveal text-center md:text-left">
            <span class="badge">Hecho en Bolivia</span>
            <h1 class="mt-4 text-3xl md:text-5xl font-extrabold leading-tight">
              Tu negocio, en internet con <span class="text-brand-700"
                >estilo</span
              > y <span class="text-brand-700">resultados</span>
            </h1>
            <p class="mt-3 text-lg text-gray-600">
              En <strong>LLAMACODE</strong> creamos páginas web atractivas, rápidas
              y pensadas para
              <strong>atraer clientes</strong>, mostrar tu marca y <strong
                >vender más</strong
              >.
            </p>
            <div
              class="mt-6 flex flex-wrap justify-center md:justify-start gap-3"
            >
              <a
                href="#planes"
                class="inline-flex items-center rounded-md px-5 py-3 btn btn-primary"
                >Ver planes</a
              >
              <a
                href={`https://wa.me/${whatsapp}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center rounded-md px-5 py-3 btn btn-ghost hover:bg-gray-100"
                >Hablar por WhatsApp</a
              >
            </div>
            <ul
              class="mt-6 grid sm:grid-cols-3 gap-3 text-sm text-gray-600 justify-center md:justify-start"
            >
              <li class="flex items-center gap-2">
                <span class="badge">Rápidas</span> &nbsp; Cargan en segundos
              </li>
              <li class="flex items-center gap-2">
                <span class="badge" style="background:#0ea5e9">Visibles</span> &nbsp;
                Listas para Google
              </li>
              <li class="flex items-center gap-2">
                <span class="badge" style="background:#f59e0b">Fáciles</span> &nbsp;
                Pensadas para tus clientes
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- SERVICIOS (beneficios claros) -->
      <section id="servicios" class="section">
        <div class="container">
          <h2 class="text-3xl font-bold mb-8 reveal">¿Qué te ofrecemos?</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="reveal card p-6">
              <h3 class="font-semibold text-lg">Diseño que vende</h3><p
                class="mt-2 text-sm text-gray-600"
              >
                Una imagen profesional que transmite confianza y convierte
                visitas en clientes.
              </p>
            </div>
            <div class="reveal card p-6">
              <h3 class="font-semibold text-lg">Velocidad real</h3><p
                class="mt-2 text-sm text-gray-600"
              >
                Páginas que cargan rápido y no hacen esperar a tus clientes.
              </p>
            </div>
            <div class="reveal card p-6">
              <h3 class="font-semibold text-lg">Visible en Google</h3><p
                class="mt-2 text-sm text-gray-600"
              >
                Estructura y etiquetas pensadas para que te encuentren.
              </p>
            </div>
            <div class="reveal card p-6">
              <h3 class="font-semibold text-lg">Se ve bien en celular</h3><p
                class="mt-2 text-sm text-gray-600"
              >
                Tus clientes te verán perfecto desde el teléfono o la
                computadora.
              </p>
            </div>
            <div class="reveal card p-6">
              <h3 class="font-semibold text-lg">Listo para crecer</h3><p
                class="mt-2 text-sm text-gray-600"
              >
                Cuando necesites blog, tienda o reservas, lo agregamos sin
                empezar de cero.
              </p>
            </div>
            <div class="reveal card p-6">
              <h3 class="font-semibold text-lg">Acompañamiento real</h3><p
                class="mt-2 text-sm text-gray-600"
              >
                Soporte y pequeños ajustes para que tu web siempre esté al día.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- PLANES (con links a landings) -->
      <section id="planes" class="section">
        <div class="container">
          <h2 class="text-3xl font-bold mb-8 reveal">Planes y precios</h2>

          <div class="grid md:grid-cols-3 gap-6">
            <!-- Básico -->
            <div class="reveal card p-6 flex flex-col">
              <div class="mb-2 text-xs uppercase tracking-wider text-gray-500">
                Básico
              </div>
              <div class="price text-4xl">
                350–500 <span class="text-xl font-semibold">Bs</span>
              </div>
              <p class="mt-2 text-sm text-gray-600">
                Página simple (1–3 secciones) para presentar tu negocio.
              </p>
              <ul class="mt-4 text-sm space-y-2">
                <li>• Diseño profesional</li>
                <li>• Se ve bien en celular</li>
                <li>• Contacto por WhatsApp o formulario</li>
                <li>• Visible en Google (básico)</li>
              </ul>
              <div class="mt-6 grid grid-cols-2 gap-3">
                <a
                  href="/planes/basico"
                  class="btn btn-ghost rounded-md text-center px-4 py-2"
                  >Ver detalle</a
                >
                <a
                  href={`https://wa.me/${whatsapp}`}
                  class="btn btn-primary rounded-md text-center px-4 py-2"
                  >Quiero este</a
                >
              </div>
            </div>

            <!-- Profesional -->
            <div
              class="reveal card p-6 border-2 border-brand-600 flex flex-col"
            >
              <div class="mb-2 flex items-center gap-2">
                <div class="text-xs uppercase tracking-wider text-gray-500">
                  Profesional
                </div>
                <span class="badge">Popular</span>
              </div>
              <div class="price text-4xl">
                800–1200 <span class="text-xl font-semibold">Bs</span>
              </div>
              <p class="mt-2 text-sm text-gray-600">
                Sitio administrable (5–8 secciones) para crecer sin depender de
                nadie.
              </p>
              <ul class="mt-4 text-sm space-y-2">
                <li>• Edita textos e imágenes tú mismo</li>
                <li>• Dominio 1 año + seguridad (HTTPS)</li>
                <li>• Noticias/Blog (opcional)</li>
                <li>• Optimizada para buen rendimiento</li>
              </ul>
              <div class="mt-6 grid grid-cols-2 gap-3">
                <a
                  href="/planes/profesional"
                  class="btn btn-ghost rounded-md text-center px-4 py-2"
                  >Ver detalle</a
                >
                <a
                  href={`https://wa.me/${whatsapp}`}
                  class="btn btn-primary rounded-md text-center px-4 py-2"
                  >Cotizar</a
                >
              </div>
            </div>

            <!-- Premium -->
            <div class="reveal card p-6 flex flex-col">
              <div class="mb-2 text-xs uppercase tracking-wider text-gray-500">
                Premium
              </div>
              <div class="price text-4xl">
                1500–2500+ <span class="text-xl font-semibold">Bs</span>
              </div>
              <p class="mt-2 text-sm text-gray-600">
                Tienda online o reservas con funciones avanzadas.
              </p>
              <ul class="mt-4 text-sm space-y-2">
                <li>• Catálogo, carrito y pagos / sistema de reservas</li>
                <li>• Descuentos, reportes y avisos por correo</li>
                <li>• Integraciones con WhatsApp y redes</li>
                <li>• Respaldos y seguridad</li>
              </ul>
              <div class="mt-6 grid grid-cols-2 gap-3">
                <a
                  href="/planes/premium"
                  class="btn btn-ghost rounded-md text-center px-4 py-2"
                  >Ver detalle</a
                >
                <a
                  href={`https://wa.me/${whatsapp}`}
                  class="btn btn-primary rounded-md text-center px-4 py-2"
                  >Hablemos</a
                >
              </div>
            </div>
          </div>

          <p class="mt-4 text-xs text-gray-500">
            * Precios referenciales. Ajustamos según alcance y tiempos.
          </p>
        </div>
      </section>

      <!-- NUESTRO PROCESO DE ÉXITO (más atractivo que “cómo trabajamos”) -->
      <section id="metodo" class="section">
        <div class="container">
          <h2 class="text-3xl font-bold mb-8 reveal">
            De la idea al sitio publicado — sin complicaciones
          </h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="reveal card p-6">
              <div
                class="h-10 w-10 rounded-full bg-brand-100 flex items-center justify-center mb-3 text-lg"
              >
                💬
              </div>
              <h3 class="font-semibold">Hablemos de tu negocio</h3>
              <p class="text-sm text-gray-600 mt-1">
                Definimos objetivos, estilo y lo que necesitas vender.
              </p>
            </div>
            <div class="reveal card p-6">
              <div
                class="h-10 w-10 rounded-full bg-brand-100 flex items-center justify-center mb-3 text-lg"
              >
                🎨
              </div>
              <h3 class="font-semibold">Diseñamos tu web</h3>
              <p class="text-sm text-gray-600 mt-1">
                Imagen profesional, clara y alineada a tu marca.
              </p>
            </div>
            <div class="reveal card p-6">
              <div
                class="h-10 w-10 rounded-full bg-brand-100 flex items-center justify-center mb-3 text-lg"
              >
                🚀
              </div>
              <h3 class="font-semibold">Publicamos y te acompañamos</h3>
              <p class="text-sm text-gray-600 mt-1">
                Lanzamiento con seguridad, soporte y pequeños ajustes.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ (texto claro para dueños de negocio) -->
      <section id="faq" class="section">
        <div class="container">
          <h2 class="text-3xl font-bold mb-8 reveal">Preguntas frecuentes</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <details class="reveal card p-5">
              <summary class="cursor-pointer font-semibold"
                >¿El precio incluye dominio y hosting?</summary
              >
              <p class="mt-2 text-sm text-gray-600">
                En <strong>Profesional</strong> y <strong>Premium</strong> te damos
                <strong>dominio por 1 año</strong> y
                <strong>hosting rápido y seguro</strong>. En el <strong
                  >Básico</strong
                > es opcional si ya tienes uno.
              </p>
            </details>

            <details class="reveal card p-5">
              <summary class="cursor-pointer font-semibold"
                >¿Podré actualizar mi página web?</summary
              >
              <p class="mt-2 text-sm text-gray-600">
                Sí. En <strong>Profesional</strong> y <strong>Premium</strong> te
                damos un
                <strong>panel sencillo</strong> para cambiar textos, fotos o precios
                cuando quieras. En <strong>Básico</strong> puedes pedirnos los cambios
                y los hacemos por ti.
              </p>
            </details>

            <details class="reveal card p-5">
              <summary class="cursor-pointer font-semibold"
                >¿Ofrecen mantenimiento?</summary
              >
              <p class="mt-2 text-sm text-gray-600">
                Sí. Planes desde <strong>50 Bs/mes</strong> con seguridad, copias
                de respaldo y cambios menores.
              </p>
            </details>

            <details class="reveal card p-5">
              <summary class="cursor-pointer font-semibold"
                >¿Cuánto tardan?</summary
              >
              <p class="mt-2 text-sm text-gray-600">
                <strong>Básico:</strong> 3–5 días hábiles. <br />
                <strong>Profesional:</strong> 1–2 semanas. <br />
                <strong>Premium:</strong> depende del alcance; siempre te damos un
                plazo realista.
              </p>
            </details>
          </div>
        </div>
      </section>

      <!-- CONTACTO -->
      <section id="contacto" class="section">
        <div class="container grid md:grid-cols-2 gap-8 items-start">
          <div class="reveal">
            <h2 class="text-3xl font-bold">¿Listo para tu web?</h2>
            <p class="mt-2 text-gray-600">
              Cuéntanos tu rubro y armamos tu propuesta.
            </p>
            <div class="mt-6 flex gap-3">
              <a
                href={`https://wa.me/${whatsapp}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center rounded-md px-5 py-3 btn btn-primary"
                >WhatsApp</a
              >
              <a
                href="mailto:hola@llamacode.dev"
                class="inline-flex items-center rounded-md px-5 py-3 btn btn-ghost hover:bg-gray-100"
                >Email</a
              >
            </div>
          </div>

          <form
            class="reveal card p-6 space-y-3"
            action="/contact.php"
            method="POST"
          >
            <div>
              <label class="text-sm font-medium">Nombre</label><input
                class="mt-1 w-full rounded-md"
                type="text"
                name="name"
                placeholder="Tu nombre"
                required
              />
            </div>
            <div>
              <label class="text-sm font-medium">Correo</label><input
                class="mt-1 w-full rounded-md"
                type="email"
                name="email"
                placeholder="tucorreo@ejemplo.com"
                required
              />
            </div>
            <div>
              <label class="text-sm font-medium">Mensaje</label><textarea
                class="mt-1 w-full rounded-md"
                rows="4"
                name="message"
                placeholder="¿Qué necesitas?"
                required></textarea>
            </div>
            <button class="w-full rounded-md px-4 py-2 btn btn-primary"
              >Enviar</button
            >
            <p class="text-xs text-gray-500">
              * En local no envía correo. En el VPS agrega <code
                >contact.php</code
              >.
            </p>
          </form>
        </div>
      </section>
    </main>

    <Footer />

    <!-- Reveal on scroll -->
    <script>
      const els = document.querySelectorAll(".reveal");
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08 },
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
